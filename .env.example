# Copy to .env and fill in locally. Never commit .env.
ANTHROPIC_API_KEY=your-class-console-key-here
# Only needed if the key above isn't scoped to one workspace: the API then rejects every
# call with "anthropic-workspace-id header required". Find the ID on the Console's
# workspace settings page.
# ANTHROPIC_WORKSPACE_ID=
# Jev (TypeSafe) key from console.typesafe.ai/keys. Also set jev_enabled = true in config.toml
# (or FAREWATCH_JEV_ENABLED=1); without the key, classification falls back to Claude.
TYPESAFE_API_KEY=your-typesafe-key-here
# Optional Turso (turso.tech): with both set, the agent keeps its SQL tables and its raw JSON
# documents (the TinyDB layer) in Turso instead of data/analytics.sqlite and data/raw.json.
# URL: `turso db show <db> --url`; token: `turso db tokens create <db>`.
# TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
# TURSO_AUTH_TOKEN=
# Optional Clairic (Cloudflare Workers AI) extraction. Also set clairic_enabled = true in
# config.toml (or FAREWATCH_CLAIRIC_ENABLED=1); without these, extraction falls back to Claude.
# Token: Cloudflare dashboard -> My Profile -> API Tokens -> "Workers AI" template.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AUTH_TOKEN=
