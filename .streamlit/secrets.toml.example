# Paste into Streamlit Community Cloud -> App settings -> Secrets. Never commit real values.
# With these unset, the dashboard runs in local mode and reads data/ on this machine.

GH_REPO = "<you>/fare-watch"

# Fine-grained, this repository only, Contents: Read-only. Downloads the data branch.
GH_DATA_TOKEN = "github_pat_..."

# Fine-grained, this repository only, Actions: Read and write. Starts review.yml (Release/Reject)
# and pipeline.yml (the sidebar's 30-minute demo button).
GH_ACTIONS_TOKEN = "github_pat_..."

# Protects Release / Reject and the demo button. Visitors can watch; only someone with this
# passcode can decide or start a run (which spends class credits).
REVIEWER_PASSCODE = "choose-a-long-passphrase"

# Optional Turso: with both set, every page reads the database from Turso instead of the
# data branch. Use a read-only token here: `turso db tokens create <db> --read-only`.
# TURSO_DATABASE_URL = "libsql://<db>-<org>.turso.io"
# TURSO_AUTH_TOKEN = "..."
