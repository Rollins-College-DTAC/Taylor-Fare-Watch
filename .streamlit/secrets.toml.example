# Paste into Streamlit Community Cloud -> App settings -> Secrets. Never commit real values.
# With these unset, the dashboard runs in local mode and reads data/ on this machine.

GH_REPO = "<you>/fare-watch"

# Fine-grained, this repository only, Contents: Read-only. Downloads the data branch.
GH_DATA_TOKEN = "github_pat_..."

# Fine-grained, this repository only, Actions: Read and write. Starts review.yml.
GH_REVIEW_TOKEN = "github_pat_..."

# Protects Release / Reject. Visitors can watch; only someone with this passcode can decide.
REVIEWER_PASSCODE = "choose-a-long-passphrase"
